# CLI tool, only in development environment.
# https://goframe.org/docs/cli
gfcli:
  gen:
    dao:
      - link: "mysql:shop:${MYSQL_PASSWORD}@tcp(127.0.0.1:3306)/banner?loc=Local&parseTime=true"
        descriptionTag: true
        # Owned by utility/eventbus, which reads and writes them by name.
        tablesEx: "outbox_event,inbox_event,quarantine_event"
    # No pbentity: database rows are never part of the public API here.

  docker:
    build: "-a amd64 -s linux -p temp -ew"
    tagPrefixes:
      - local/goframeshop-banner
