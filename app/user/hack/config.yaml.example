
# CLI tool, only in development environment.
# https://goframe.org/docs/cli
gfcli:
  gen:
    dao:
      - link: "mysql:shop:${MYSQL_PASSWORD}@tcp(127.0.0.1:3306)/user?loc=Local&parseTime=true"
        descriptionTag: true

    pbentity:
      - link: "mysql:shop:${MYSQL_PASSWORD}@tcp(127.0.0.1:3306)/user?loc=Local&parseTime=true"

  docker:
    build: "-a amd64 -s linux -p temp -ew"
    tagPrefixes:
      - local/goframeshop-user
