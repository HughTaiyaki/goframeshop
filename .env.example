# Local development. Copy to .env and choose your own passwords: compose,
# `make dev-config` and the integration tests read them from there. .env is
# ignored by git; nothing that holds a password is committed.
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=user
MYSQL_USER=shop
MYSQL_PASSWORD=change-me
# The search service's read-only binlog account (deploy/mysql/init/007).
SEARCH_SYNC_PASSWORD=change-me
REDIS_PORT=6379
REDIS_PASSWORD=change-me
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=change-me
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
